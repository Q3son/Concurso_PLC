# Copia este archivo como .env y ajusta los valores

# sim = planta simulada | plc = CODESYS real
MODE=plc
PORT=3000
POLL_MS=200

# Servidor OPC UA de CODESYS Control Win (puerto por defecto 4840)
OPCUA_ENDPOINT=opc.tcp://localhost:4840
# Si tu runtime exige usuario (CODESYS SP17+ con gestion de usuarios):
OPCUA_USER=
OPCUA_PASSWORD=
# Dejalo vacio para autodetectar. Si falla, ejecuta "npm run browse" y copia el nombre aqui.
OPCUA_DEVICE=
OPCUA_APPLICATION=Application

# Botonera fisica opcional con Arduino (ej. COM5 en Windows, /dev/ttyACM0 en Linux)
ARDUINO_PORT=
ARDUINO_BAUD=115200
