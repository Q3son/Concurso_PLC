(* Imagen de E/S de la celda. Se enlaza a los canales del "Modbus TCP Slave Device"
   en la pestana de mapeo de E/S (ver docs/02-mapa-io.md).
   Codigos (S5, M3, Y02, WS1...) = los del plano: docs/img/plano-celda.png
   Correcciones del jurado aplicadas: S1 y S3 eliminados; S2/S4 = pieza lista para empujar;
   S5 = pieza caida en la faja principal; S6.1/S6.2 = vision digital crudo verde/azul. *)
{attribute 'qualified_only'}
VAR_GLOBAL
    (* ================= ENTRADAS DIGITALES (Coils 0..33, escritas por Factory I/O) ================= *)
    (* --- Panel del operador --- *)
    xFio_Running     : BOOL;  (* 0   -      FACTORY I/O (Running) *)
    xBtn_Start       : BOOL;  (* 1   PB1    Start (NA) *)
    xBtn_Stop        : BOOL;  (* 2   PB2    Stop (NC) *)
    xBtn_Reset       : BOOL;  (* 3   PB3    Reset (NA) *)
    xBtn_EStop       : BOOL;  (* 4   ES1    Paro de emergencia (NC) *)
    xSel_Auto        : BOOL;  (* 5   SW1    Selector Auto(1) / Manual(0) *)
    (* --- Zona 1: alimentacion --- *)
    xS2_Feed1Ready   : BOOL;  (* 6   S2     Diffuse: pieza verde lista frente a Y01 (fin de M1) *)
    xY01_Front       : BOOL;  (* 7   LS1    Pusher Y01 adelante *)
    xY01_Back        : BOOL;  (* 8   LS2    Pusher Y01 atras *)
    xS4_Feed2Ready   : BOOL;  (* 9   S4     Diffuse: pieza azul lista frente a Y02 (fin de M2) *)
    xY02_Front       : BOOL;  (* 10  LS3    Pusher Y02 adelante *)
    xY02_Back        : BOOL;  (* 11  LS4    Pusher Y02 atras *)
    xS5_MainDrop     : BOOL;  (* 12  S5     Diffuse: pieza cayo en la faja principal M3 *)
    (* --- Zona 2: identificacion y wheel sorter --- *)
    xS61_GreenRaw    : BOOL;  (* 13  S6.1   Vision (Green Raw Material): crudo verde *)
    xS62_BlueRaw     : BOOL;  (* 14  S6.2   Vision (Blue Raw Material): crudo azul *)
    xS7_Sorter       : BOOL;  (* 15  S7     Diffuse: presencia de pieza en el wheel sorter *)
    (* --- Zona 3: ramas y centros de mecanizado --- *)
    xS8_LidsEntry    : BOOL;  (* 16  S8     Diffuse: pieza en la bahia de entrada de MC1 (tapas) *)
    xS9_BasesEntry   : BOOL;  (* 17  S9     Diffuse: pieza en la bahia de entrada de MC2 (bases) *)
    xMC1_Busy        : BOOL;  (* 18  MC1    Machining Center 1 (Is Busy) *)
    xMC1_Error       : BOOL;  (* 19  MC1    Machining Center 1 (Has Error) *)
    xMC1_Opened      : BOOL;  (* 20  MC1    Machining Center 1 (Opened) - puerta de seguridad *)
    xMC2_Busy        : BOOL;  (* 21  MC2    Machining Center 2 (Is Busy) *)
    xMC2_Error       : BOOL;  (* 22  MC2    Machining Center 2 (Has Error) *)
    xMC2_Opened      : BOOL;  (* 23  MC2    Machining Center 2 (Opened) *)
    (* --- Zona 4: segregacion por color y conteo --- *)
    xS10_GreenLid    : BOOL;  (* 24  S10    Vision (Green Product Lid) frente a Y03 *)
    xY03_Front       : BOOL;  (* 25  LS5    Pusher Y03 adelante *)
    xY03_Back        : BOOL;  (* 26  LS6    Pusher Y03 atras *)
    xS11_GreenBase   : BOOL;  (* 27  S11    Vision (Green Product Base) frente a Y04 *)
    xY04_Front       : BOOL;  (* 28  LS7    Pusher Y04 adelante *)
    xY04_Back        : BOOL;  (* 29  LS8    Pusher Y04 atras *)
    xS12_BlueLids    : BOOL;  (* 30  S12    Capacitive: fin de M6, cuenta tapas azules *)
    xS13_GreenLids   : BOOL;  (* 31  S13    Capacitive: fin de M7, cuenta tapas verdes *)
    xS14_BlueBases   : BOOL;  (* 32  S14    Capacitive: fin de M8, cuenta bases azules *)
    xS15_GreenBases  : BOOL;  (* 33  S15    Capacitive: fin de M9, cuenta bases verdes *)

    (* ================= ENTRADAS DE REGISTRO (Holding Registers 0..1) ================= *)
    iMC1_Progress    : INT;   (* 0   MC1    Machining Center 1 (Progress) 0..100 % *)
    iMC2_Progress    : INT;   (* 1   MC2    Machining Center 2 (Progress) 0..100 % *)

    (* ================= SALIDAS DIGITALES (Discrete Inputs 0..31, leidas por Factory I/O) ================= *)
    (* --- Zona 1 --- *)
    xE1_EmitGreen    : BOOL;  (* 0   E1     Emitter 1 (Emit): crudo verde *)
    xE2_EmitBlue     : BOOL;  (* 1   E2     Emitter 2 (Emit): crudo azul *)
    xM1_Feed1        : BOOL;  (* 2   M1     Belt Conveyor: faja alimentadora 1 (verde) *)
    xM2_Feed2        : BOOL;  (* 3   M2     Belt Conveyor: faja alimentadora 2 (azul) *)
    xY01_Push        : BOOL;  (* 4   Y01    Pusher: faja 1 -> faja principal *)
    xY02_Push        : BOOL;  (* 5   Y02    Pusher: faja 2 -> faja principal *)
    xM3_Main         : BOOL;  (* 6   M3     Belt Conveyor: faja alimentadora principal *)
    (* --- Zona 2 --- *)
    xWS_Plus         : BOOL;  (* 7   WS1+   Pop Up Wheel Sorter (+): eleva y gira las ruedas *)
    xWS_Left         : BOOL;  (* 8   WS1L   Pop Up Wheel Sorter (Left) *)
    xWS_Right        : BOOL;  (* 9   WS1R   Pop Up Wheel Sorter (Right) *)
    (* --- Zona 3 --- *)
    xM4_LidsBranch   : BOOL;  (* 10  M4     Belt Conveyor: rama de tapas *)
    xM5_BasesBranch  : BOOL;  (* 11  M5     Belt Conveyor: rama de bases *)
    xMC1_Start       : BOOL;  (* 12  MC1    Machining Center 1 (Start) *)
    xMC1_Stop        : BOOL;  (* 13  MC1    Machining Center 1 (Stop) *)
    xMC1_Reset       : BOOL;  (* 14  MC1    Machining Center 1 (Reset) *)
    xMC1_ProduceLids : BOOL;  (* 15  MC1    Machining Center 1 (Produce Lids) = TRUE *)
    xMC2_Start       : BOOL;  (* 16  MC2    Machining Center 2 (Start) *)
    xMC2_Stop        : BOOL;  (* 17  MC2    Machining Center 2 (Stop) *)
    xMC2_Reset       : BOOL;  (* 18  MC2    Machining Center 2 (Reset) *)
    xMC2_ProduceLids : BOOL;  (* 19  MC2    Machining Center 2 (Produce Lids) = FALSE -> bases *)
    (* --- Zona 4 --- *)
    xM6_LidsOut      : BOOL;  (* 20  M6     Belt Conveyor: salida de tapas (azules siguen de largo) *)
    xY03_Push        : BOOL;  (* 21  Y03    Pusher: tapas verdes -> M7 *)
    xM7_GreenLids    : BOOL;  (* 22  M7     Belt Conveyor: salida de tapas verdes *)
    xM8_BasesOut     : BOOL;  (* 23  M8     Belt Conveyor: salida de bases (azules siguen de largo) *)
    xY04_Push        : BOOL;  (* 24  Y04    Pusher: bases verdes -> M9 *)
    xM9_GreenBases   : BOOL;  (* 25  M9     Belt Conveyor: salida de bases verdes *)
    (* --- Senalizacion --- *)
    xLamp_Green      : BOOL;  (* 26  H1     Stack Light verde *)
    xLamp_Yellow     : BOOL;  (* 27  H2     Stack Light amarilla *)
    xLamp_Red        : BOOL;  (* 28  H3     Stack Light roja *)
    xLamp_Start      : BOOL;  (* 29  H4     Luz boton Start *)
    xLamp_Reset      : BOOL;  (* 30  H5     Luz boton Reset *)
    xLamp_Stop       : BOOL;  (* 31  H6     Luz boton Stop *)

    (* ================= SALIDA DE REGISTRO (Input Register 0) ================= *)
    iDisplay         : INT;   (* 0   D1     Digital Display: productos terminados *)
END_VAR
