  subgraph SUP["Supervisión"]
    direction LR
    SRV["server.js<br/>cliente OPC UA"]
    WEB["Tablero web<br/>sinóptico 2D, gemelo 3D,<br/>alarmas, lote, KPI"]
    ARD["Arduino opcional<br/>botonera física"]
